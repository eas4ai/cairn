// Existing project: initialize or resume, reconcile the spec, then enter the shared tail.
digraph existing_project {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="Existing project: start to the spec-phase tail"];
  node  [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10];

  start [shape=oval, label="Start: /existing-project"];
  state [shape=diamond, label="Cairn state?"];
  tonext [shape=oval, label="Done: switch to /next-feature;\nthis work is a later commitment"];
  fits [shape=diamond, label="Request belongs to the\nopen commitment?"];
  continue [shape=oval, label="Return to the work loop"];
  midway [shape=diamond, label="Commitment open:\ndeveloper chooses"];
  finish [shape=oval, label="Finish current commitment;\ncapture request as an item"];
  supersede [label="cairn supersede SUCCESSOR:\nclose old range with decision, transition id and slug;\ncarry open obligations; do not name a future start\nor move Current:"];
  pending [label="Pending successor: resume the transition;\nthe later start points back to the superseded record"];
  init [label="cairn init; developer confirms settings,\nauthority remote or local-only, and auth mode"];
  hasspec [shape=diamond, label="docs/spec/overview.md exists?"];
  readspec [label="Path B: read glossary, keystone, domains,\nroadmap, decisions and items first"];
  recon [label="Recon before questions:\nmanifests, entry points, data, tests, CI, scripts,\nnon-spec docs and recent history"];
  report [label="docs/recon.md, every row cited:\nExists / Documented / Contradicted / Unverified;\ncarry unresolved earlier findings"];
  corrects [label="Present; developer corrects the reading"];
  ask [label="One open question:\nfeature to add or defect to fix?"];
  radius [label="Trace and cite blast radius:\nmodules, tests and spec sections"];
  pathA [label="Path A: glossary from code identifiers;\nObserved specs in radius; map rows outside"];
  pathB [label="Path B: verify every spec section in radius"];
  verdict [shape=diamond, label="Holds / Drifted /\nStill Observed / Missing"];
  drift [label="Raise both sides with citations;\ndeveloper rules"];
  rule [shape=diamond, label="Which side is wrong?"];
  specwrong [label="Spec wrong: revise by developer ruling\nbefore successor start"];
  codewrong [label="Code wrong: spec stands;\ncreate defect item"];
  missing [label="Write missing behavior as Observed"];
  confirm [label="Confirmed Observed sections become Draft with falsifiers;\nothers remain Observed and are not contract"];
  roadmap [label="Prepare roadmap section; a defect commitment names\nthe violated requirement and reproducing mechanism"];
  tail [shape=box, peripheries=2, label="spec-phase.dot:\nconfirm blocks, declare, agreement, commit,\nstart (with supersession link when present), wake"];

  start -> state;
  state -> tonext [label="Done"];
  state -> fits [label="open commitment"];
  state -> pending [label="pending successor"];
  state -> init [label="not initialized"];
  state -> hasspec [label="initialized, no open range"];
  fits -> continue [label="yes"];
  fits -> midway [label="no"];
  midway -> finish [label="finish"];
  midway -> supersede [label="supersede"];
  supersede -> pending;
  pending -> readspec;
  init -> hasspec;
  hasspec -> readspec [label="yes (B)"];
  hasspec -> recon [label="no (A)"];
  readspec -> recon;
  recon -> report -> corrects -> ask -> radius;
  radius -> pathA [label="A"];
  radius -> pathB [label="B"];
  pathB -> verdict;
  verdict -> confirm [label="holds"];
  verdict -> drift [label="drifted"];
  verdict -> confirm [label="still Observed"];
  verdict -> missing [label="missing"];
  drift -> rule;
  rule -> specwrong [label="spec"];
  rule -> codewrong [label="code"];
  specwrong -> confirm; codewrong -> confirm; missing -> confirm;
  pathA -> confirm;
  confirm -> roadmap -> tail;
}
