// Existing project: from a codebase Cairn has not specified, or one whose spec drifted, to the spec-phase tail.
digraph existing_project {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="Existing project: start to the spec-phase tail"];
  node  [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10];

  start [shape=oval, label="Start: /existing-project"];
  wake [shape=diamond, label="cairn wake?"];
  tonext [shape=oval, label="Done: switch to /next-feature;\nthe work is a later commitment"];
  midway [shape=diamond, label="Resolvable or Waiting:\na commitment is under way.\nDeveloper chooses"];
  finish [shape=oval, label="Finish the current commitment;\ncapture the request as an item"];
  supersede_c [label="Supersede the commitment by a\nConsequential decision quoting the developer;\nmove Current:"];
  hasspec [shape=diamond, label="docs/spec/overview.md\nexists?"];
  readspec [label="Path B: read the spec set first:\nglossary, keystone, domains, roadmap,\ncommitment, decisions, items"];
  recon [label="Recon before questions:\nmanifests; entry points; data; tests;\nCI and scripts; docs outside the spec; recent history\n(B: every commit since the newest Agreed date)"];
  report [label="docs/recon.md, every row cited:\nExists / Documented / Contradicted / Unverified;\ncarry unresolved earlier findings forward"];
  corrects [label="Present; developer corrects the reading"];
  ask [label="The one open question:\na feature to add, or a defect to fix?"];
  radius [label="Trace the blast radius:\nmodules, tests, spec sections; cite each"];
  pathA [label="Path A: glossary from the code's identifiers;\nObserved specs inside the radius,\none-line rows in the spec map outside"];
  pathB [label="Path B: verify each spec section in the radius"];
  verdict [shape=diamond, label="Holds / Drifted /\nStill Observed / Missing"];
  drift [label="Raise both sides, cited;\nthe developer rules"];
  rule [shape=diamond, label="Which side is wrong?"];
  specwrong [label="Spec wrong: the developer's ruling revises\nthe Agreed text, cause named"];
  codewrong [label="Code wrong: the section stands;\ncairn item --defect names it"];
  missing [label="Write it as Observed,\nas Path A would"];
  confirm [label="Observed sections the developer confirms\nbecome Draft with falsifiers;\nthe rest stay Observed and are not contract"];
  roadmap [label="Roadmap with Current: if none exists;\na defect commitment names the requirement it violates\nand a mechanism that reproduces it"];
  tail [shape=box, peripheries=2, label="The spec-phase tail (spec-phase.dot):\nfalsifiers as a set, self-review,\nlint, present, confirm per block, commitment,\ndeclare, AGENTS.md, commit, wake"];

  start -> wake;
  wake -> tonext [label="Done"];
  wake -> midway [label="Resolvable | Waiting"];
  wake -> hasspec [label="not a project, or Escalate answered"];
  midway -> finish [label="finish"];
  midway -> supersede_c [label="supersede"];
  supersede_c -> hasspec;
  hasspec -> readspec [label="yes (B)"];
  hasspec -> recon [label="no (A)"];
  readspec -> recon;
  recon -> report -> corrects -> ask -> radius;
  radius -> pathA [label="A"];
  radius -> pathB [label="B"];
  pathB -> verdict;
  verdict -> confirm [label="holds: cite,\nwrite nothing"];
  verdict -> drift [label="drifted"];
  verdict -> confirm [label="still Observed"];
  verdict -> missing [label="missing"];
  drift -> rule;
  rule -> specwrong [label="spec"];
  rule -> codewrong [label="code"];
  specwrong -> confirm; codewrong -> confirm; missing -> confirm;
  pathA -> confirm;
  confirm -> roadmap -> tail;
}
