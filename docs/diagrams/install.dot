// Install: from a harness with no Cairn to a working command, hooks and skills.
digraph install {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="Install: start to done"];
  node  [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10];

  start [shape=oval, label="Start: a harness\nwith no Cairn"];
  prereq [shape=diamond, label="node and git\navailable?"];
  missing [shape=oval, label="Stop: name the\nmissing prerequisite"];
  harness [shape=diamond, label="Which harness?"];
  cc [label="Claude Code or Codex:\nplugin marketplace add eas4ai/cairn\nplugin install cairn@cairn\n(hooks registered by the plugin)"];
  muse [label="Muse:\nmuse plugins install <checkout>\n(hooks registered by the plugin)"];
  other [label="Any other agent:\nnpx skills add eas4ai/cairn\nthen /install-cairn: clone the checkout,\nregister the hooks where the harness has them"];
  nohooks [label="No hook system: Cairn is instruction-only;\nthe working agreement is the whole enforcement"];
  link [label="/install-cairn or the plugin's install step\nlinks ~/.local/bin/cairn to bin/cairn.mjs, once,\nand asks the developer to confirm the authority remote\n(origin proposed, never assumed); only it gets refs/cairn/*"];
  path [shape=diamond, label="~/.local/bin on PATH?"];
  addpath [label="Say so; the developer adds it\n(no hook edits the shell)"];
  help [shape=diamond, label="cairn --help prints\ncommands and exit codes?"];
  broken [shape=oval, label="Stop: name the failure\n(link target, PATH, node)"];
  project [shape=diamond, label="Inside a Git repo with\ndocs/spec/roadmap.md?"];
  wake [label="The session-start hook prints\nthe verdict and its predicate"];
  choose [label="Choose the entry skill:\n/new-project for software that does not exist\n/existing-project for a codebase"];
  done [shape=box, peripheries=2, label="Done: the command resolves and helps;\nthe hooks are registered where the harness has them;\nthe four skills are listed"];

  start -> prereq;
  prereq -> missing [label="no"];
  prereq -> harness [label="yes"];
  harness -> cc [label="Claude Code, Codex"];
  harness -> muse [label="Muse"];
  harness -> other [label="other"];
  other -> nohooks [label="no hook system"];
  cc -> link; muse -> link; other -> link; nohooks -> link;
  link -> path;
  path -> addpath [label="no"];
  path -> help [label="yes"];
  addpath -> help;
  help -> broken [label="no"];
  help -> project [label="yes"];
  project -> wake [label="yes"];
  project -> choose [label="no"];
  wake -> done;
  choose -> done;
}
