// Next feature: from Done to drafted or revised requirements, then the shared tail.
digraph next_feature {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, labelloc=t, label="Next feature: start to the spec-phase tail"];
  node  [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10];

  start [shape=oval, label="Start: /next-feature"];
  isdone [shape=diamond, label="sudus wake says Done?"];
  notdone [shape=oval, label="Stop: hand the verdict\nto the working agreement"];
  read [label="Read the spec set, finished roadmap section,\nConsequential queue, unpromoted next-feature items\nand backlog"];
  ask [label="One open question:\nwaiting items, a new feature, or both?"];

  subgraph cluster_change {
    label="For each requested change"; style=dashed; fontname="Helvetica"; fontsize=11;
    radius [label="Trace and cite the blast radius:\nrequirements, mechanisms, code, documents"];
    restate [label="Restate what changes for whom; quote affected Agreed text;\ngive the alternative and recommendation"];
    corrects [label="Developer corrects the reading"];
    fits [shape=diamond, label="Covered by current\nAgreed requirements?"];
    covered [label="Put it into the commitment;\nwrite no new contract text"];
    revise [label="Revise under the same identifier or add Draft;\nRationale: at most one line"];
    next [shape=diamond, label="More changes?"];
  }

  tail [shape=box, peripheries=2, label="spec-phase.dot:\nfalsifiers, self-review, lint, confirmation,\nroadmap, declarations, agreement, start, wake"];

  start -> isdone;
  isdone -> notdone [label="no"];
  isdone -> read [label="yes"];
  read -> ask -> radius -> restate -> corrects -> fits;
  fits -> covered [label="yes"];
  fits -> revise [label="no"];
  covered -> next; revise -> next;
  next -> radius [label="yes"];
  next -> tail [label="no"];
}
